<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="应用落点" Width="820" Height="790" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8" Foreground="#171D28"
        FontFamily="Segoe UI, Microsoft YaHei UI" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#171D28"/>
    <SolidColorBrush x:Key="Muted" Color="#586677"/>
    <SolidColorBrush x:Key="Accent" Color="#0866E8"/>
    <Style TargetType="Button" x:Key="ButtonBase">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Foreground" Value="#263448"/>
      <Setter Property="Background" Value="#EEF2F7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".65"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#4888D8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".43"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="22,10"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#C3CEDC"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Caption">
      <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E4E9F1" BorderThickness="0,0,0,1" Padding="26,13">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock Text="应用落点" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="674" Margin="26,30,26,28">
        <TextBlock Text="安装到你选的位置" FontSize="37" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="拖入安装包或便携版，再选择要存放的目录。" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,23" FontSize="14"/>
        <Grid x:Name="DropArea" Background="Transparent" AllowDrop="True" MinHeight="223" ClipToBounds="True">
          <Rectangle x:Name="DropSurface" Fill="#FAFCFF" Stroke="#9DAFC7" StrokeThickness="1" StrokeDashArray="5 5" RadiusX="24" RadiusY="24"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,18">
            <Border x:Name="IconTile" Background="#E6F0FF" Width="60" Height="60" CornerRadius="18" HorizontalAlignment="Center">
              <TextBlock x:Name="DropIcon" Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="DropTitle" Text="将应用拖到这里" TextTrimming="CharacterEllipsis" FontSize="19" TextAlignment="Center" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBlock x:Name="DropHint" Text="MSI、EXE、ZIP 或便携版文件夹" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,5,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="PickFile" Style="{StaticResource ButtonBase}" Content="选择文件"/>
              <Button x:Name="PickSourceFolder" Style="{StaticResource ButtonBase}" Content="选择文件夹" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border Background="White" BorderBrush="#E0E6EE" BorderThickness="1" CornerRadius="20" Margin="0,17,0,0" Padding="20,17">
          <StackPanel>
            <Label Content="目标位置" Target="{Binding ElementName=TargetRoot}" Padding="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,8"/>
            <DockPanel>
              <Button x:Name="BrowseTarget" DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Content="浏览…" Margin="8,0,0,0"/>
              <TextBox x:Name="TargetRoot"/>
            </DockPanel>
            <StackPanel x:Name="Options" Visibility="Collapsed" Margin="0,12,0,0">
              <Grid x:Name="ModeRow" Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Content="处理方式" Target="{Binding ElementName=ModeChoice}" Padding="0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <ComboBox x:Name="ModeChoice" Grid.Column="1" MinHeight="34" Padding="8,4"/>
              </Grid>
              <Grid x:Name="PropertyRow" Visibility="Collapsed" Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Content="MSI 目录属性" Target="{Binding ElementName=MsiProperty}" Padding="0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="MsiProperty" Grid.Column="1" ToolTip="使用软件厂商文档中注明的 MSI 目录属性，例如 INSTALLFOLDER。"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Content="应用文件夹名" Target="{Binding ElementName=FolderName}" Padding="0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="FolderName" Grid.Column="1"/>
              </Grid>
            </StackPanel>
            <TextBlock x:Name="Preview" Text="选择应用后，这里会显示完整路径。" Style="{StaticResource Caption}" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,12,0"
                     a:AutomationProperties.LiveSetting="Polite" Text="选择文件后可预览目标路径。"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="OpenTarget" Style="{StaticResource ButtonBase}" Content="打开文件夹" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="Commit" Style="{StaticResource Primary}" Content="开始安装" IsEnabled="False"/>
          </StackPanel>
        </Grid>
        <ProgressBar x:Name="Pulse" Height="3" Margin="2,10,2,0" IsIndeterminate="True" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
